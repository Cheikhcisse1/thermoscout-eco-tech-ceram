# Copie ce fichier en ".env" (jamais publié). Ne mets jamais de vraie clé dans ce fichier-ci.
DEFAULT_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3
# Modèle plus léger/rapide pour le chat (vide = utilise OLLAMA_MODEL). Ex: hermes3:3b
OLLAMA_CHAT_MODEL=
# Optionnel : Claude (nécessite des crédits API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# IA gratuite Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Démo publique sans mot de passe (Gemini imposé, paramètres en lecture seule)
PUBLIC_MODE=0
